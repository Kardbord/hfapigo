meta {
  name: Image Text to Text - Params
  type: http
  seq: 2
}

post {
  url: {{HF_BASE_URL}}/hf-inference/models/{{model_image_text_to_text}}
  body: multipartForm
  auth: bearer
}

body:multipart-form {
  inputs: @file({{sample_png}})
  text: Describe this image in detail.
  parameters: {"max_new_tokens": 300, "temperature": 0.8, "top_p": 0.95}
}
