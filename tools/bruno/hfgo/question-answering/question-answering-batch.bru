  Content-Type: application/json
}

body:json {
  {
    "inputs": [
      {
        "question": "What is the capital of France?",
        "context": "The capital of France is Paris."
      },
      {
        "question": "Who founded Go?",
        "context": "Go was designed at Google by Robert Griesemer, Rob Pike, and Ken Thompson."
      }
    ],
    "parameters": {}
  }
}
