meta {
  name: Image Segmentation - Params
  type: http
  seq: 2
}

post {
  url: {{HF_BASE_URL}}/hf-inference/models/{{model_image_segmentation}}
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  inputs: @file({{sample_png}})
  parameters: {"mask_threshold": 0.5, "subtask": "panoptic", "threshold": 0.5}
}
