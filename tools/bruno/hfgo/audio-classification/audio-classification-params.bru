meta {
  name: Audio Classification - Params
  type: http
  seq: 2
}

post {
  url: {{HF_BASE_URL}}/hf-inference/models/{{model_audio_classification}}
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  inputs: @file({{sample_audio}})
  parameters: {"function_to_apply": "softmax", "top_k": 5}
}
