meta {
  name: Text to Video - Params
  type: http
  seq: 2
}

post {
  url: {{HF_BASE_URL}}/hf-inference/models/{{model_text_to_video}}
  body: json
  auth: inherit
}

body:json {
  {
    "inputs": "A dog running through a sunny park.",
    "parameters": {
      "num_frames": 24,
      "guidance_scale": 6.0,
      "negative_prompt": ["blurry", "low quality"],
      "num_inference_steps": 40,
      "seed": 7
    }
  }
}
